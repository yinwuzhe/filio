{
  "name": "folio-rss",
  "version": "1.0.0",
  "private": true,
  "description": "A quieter place for your favorite reads.",
  "author": "Folio",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "package:mac": "npm run build && electron-builder --mac dmg --publish never",
    "test": "node --test server/*.test.mjs && vitest run src",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew --no-daemon assembleDebug",
    "android:test": "cd android && ./gradlew --no-daemon testDebugUnitTest",
    "android:run": "npm run android:sync && cap run android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.0.1",
    "@capacitor/core": "8.5.2",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "dompurify": "3.4.15",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rss-parser": "3.13.0",
    "sax": "1.6.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.10.5",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "jsdom": "26.1.0",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "wait-on": "8.0.2"
  },
  "build": {
    "appId": "app.folio.reader",
    "productName": "Folio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/feeds.mjs",
      "server/translation.mjs",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.news",
      "target": [
        "dmg"
      ]
    }
  }
}
